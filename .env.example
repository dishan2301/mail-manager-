ENVIRONMENT=development
DATABASE_URL=mssql+pyodbc://oeis_app:YourStrongPassword@sqlserver/OEIS?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_URL=redis://:replace-with-a-random-redis-password@redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
MAX_SESSIONS_PER_USER=10
JWT_ISSUER=oeis-api
JWT_AUDIENCE=oeis-web
TOKEN_ENCRYPTION_KEY=<URL_SAFE_BASE64_32_BYTE_KEY>
TOKEN_ENCRYPTION_KEY_ID=v1
TOKEN_ENCRYPTION_PREVIOUS_KEYS={}
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-secret-from-a-secret-store
# Preferred alternative to AZURE_CLIENT_SECRET (PEM private key + Entra certificate thumbprint)
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE_THUMBPRINT=
GRAPH_SCOPE=https://graph.microsoft.com/.default
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email
FRONTEND_URL=http://localhost:5173
SYNC_INTERVAL_SECONDS=300
SYNC_STALE_AFTER_SECONDS=900
# Enable on exactly one scheduler deployment; keep false on API replicas.
SCHEDULER_ENABLED=true
SUMMARY_HOUR=18
APP_TIMEZONE=Asia/Kolkata
BOOTSTRAP_ADMIN_EMAIL=admin@company.com
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=notifications@company.com
SMTP_PASSWORD=store-in-secret-manager
SMTP_FROM=notifications@company.com
MANAGER_EMAIL=manager@company.com
DIRECTOR_EMAIL=director@company.com
DASHBOARD_URL=https://oeis.company.com
MANAGER_TENANT_WIDE_ACCESS=false
MAX_REPORT_ROWS=10000
MAX_SYNC_MESSAGES=10000
MAX_REQUEST_BYTES=1048576
ALLOWED_HOSTS=oeis.company.com
ENABLE_API_DOCS=false
